# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gooutplanner

# Server
PORT=4000

# Better Auth
BETTER_AUTH_SECRET=your-random-secret-here
# In production this MUST be the Vercel frontend URL (not the Render backend URL),
# so that OAuth callbacks and cookie paths are same-origin with the browser.
# Example: BETTER_AUTH_URL=https://go-out-planner.vercel.app
BETTER_AUTH_URL=http://localhost:4000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS — comma-separated origins (no wildcard with credentials)
# In production, set to your Vercel frontend URL
CORS_ORIGIN=http://localhost:5173

# Better Auth trusted origins — comma-separated
TRUSTED_ORIGINS=http://localhost:5173
