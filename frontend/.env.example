# In development, these point to localhost.
#
# In production (Vercel), set these in your dashboard:
#   VITE_AUTH_URL = <your-vercel-domain>    (same origin via Vercel API proxy)
#   VITE_APP_URL  = <your-vercel-domain>
#
# Example:
#   VITE_AUTH_URL=https://go-out-planner.vercel.app
#   VITE_APP_URL=https://go-out-planner.vercel.app

VITE_AUTH_URL=http://localhost:4000
VITE_APP_URL=http://localhost:5173
